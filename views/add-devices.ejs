<!DOCTYPE html>
<html>
<head>
    <title>Gerät hinzufügen</title>
</head>
<body>

<h2>Neues Gerät</h2>

<form method="POST" action="/devices/add">
    <input type="text" name="name" placeholder="Gerätename" required />
    <input type="text" name="type" placeholder="Gerätetyp" required />
    <input type="text" name="software_version" placeholder="Software Version" />
    
    <select name="update_status">
        <option value="up-to-date">Up-to-date</option>
        <option value="update-available">Update verfügbar</option>
        <option value="critical">Kritisch</option>
    </select>

    <button type="submit">Speichern</button>
</form>

<a href="/devices">Zurück</a>

</body>
</html>