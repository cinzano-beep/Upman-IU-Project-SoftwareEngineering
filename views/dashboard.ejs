<!DOCTYPE html>
<html>
<head>
    <title><%= appName %> – Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f4f6f9;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
        }

        h1 {
            margin-bottom: 10px;
        }

        .role {
            color: #666;
            margin-bottom: 30px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .card h2 {
            margin: 0;
            font-size: 30px;
        }

        .card p {
            margin-top: 8px;
            color: #666;
        }

        .critical {
            border-left: 6px solid #e74c3c;
        }

        .update {
            border-left: 6px solid #f39c12;
        }

        .buttons {
            margin-bottom: 40px;
        }

        .buttons a {
            display: inline-block;
            margin-right: 15px;
            padding: 10px 18px;
            background: #3498db;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            transition: 0.2s;
        }

        .buttons a:hover {
            background: #2980b9;
        }

        .logout {
            background: #555 !important;
        }

        .section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            margin-bottom: 30px;
        }

        .section h3 {
            margin-top: 0;
        }

        .cve-box {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

        .cve-id {
            font-weight: bold;
            color: #c0392b;
        }

        .cve-date {
            font-size: 12px;
            color: #888;
        }

    </style>
</head>
<body>

<div class="container">

    <h1><%= appName %> Dashboard</h1>
    <div class="role">
        Willkommen – Rolle: <strong><%= user.role %></strong>
    </div>

    <div class="cards">
        <div class="card">
            <h2><%= stats.totalDevices %></h2>
            <p>Geräte gesamt</p>
        </div>

        <div class="card critical">
            <h2><%= stats.criticalDevices %></h2>
            <p>Kritische Updates</p>
        </div>

        <div class="card update">
            <h2><%= stats.updateAvailableDevices %></h2>
            <p>Updates verfügbar</p>
        </div>

        <% if (user.role === "admin") { %>
        <div class="card">
            <h2><%= totalUsers %></h2>
            <p>Benutzer gesamt</p>
        </div>
        <% } %>
    </div>

    <div class="buttons">
        <a href="/devices">Geräte verwalten</a>
        <a href="/devices/add">Neues Gerät</a>
        <a class="logout" href="/logout">Logout</a>
    </div>

    <% if (stats.criticalDevices > 0) { %>
        <div class="section">
            <h3>⚠ Kritische Systemwarnung</h3>
            <p>
                Es sind <strong><%= stats.criticalDevices %></strong> Geräte mit kritischen Updates vorhanden.
                Bitte prüfen Sie diese umgehend.
            </p>
        </div>
    <% } %>

    <div class="section">
        <h3>Aktuelle Sicherheitswarnungen (NVD / NIST)</h3>

        <% if (advisories.length === 0) { %>
            <p>Keine aktuellen Meldungen verfügbar.</p>
        <% } %>

        <% advisories.forEach(item => { %>
            <div class="cve-box">
                <div class="cve-id"><%= item.id %></div>
                <div><%= item.description %></div>
                <div class="cve-date">Veröffentlicht: <%= new Date(item.published).toLocaleDateString() %></div>
            </div>
        <% }) %>

    </div>

</div>

</body>
</html>