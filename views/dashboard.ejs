<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            margin: 0;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 20px;
        }

        h1 {
            margin-bottom: 10px;
        }

        .role {
            color: #666;
            margin-bottom: 30px;
        }

        .cards {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            flex: 1;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .card h2 {
            margin: 0;
            font-size: 28px;
        }

        .card p {
            margin: 5px 0 0;
            color: #888;
        }

        .critical {
            border-left: 5px solid #e74c3c;
        }

        .nav {
            margin-top: 20px;
        }

        .nav a {
            display: inline-block;
            margin-right: 15px;
            padding: 10px 15px;
            background: #3498db;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        .nav a.logout {
            background: #555;
        }

    </style>
</head>
<body>

<div class="container">
    <h1>Dashboard</h1>
    <div class="role">
        Willkommen <strong><%= user.username %></strong> – Rolle: <%= user.role %>
    </div>

    <div class="cards">
        <div class="card">
            <h2><%= stats.totalDevices %></h2>
            <p>Geräte gesamt</p>
        </div>

        <div class="card critical">
            <h2><%= stats.criticalUpdates %></h2>
            <p>Kritische Updates</p>
        </div>

        <% if (user.role === "admin") { %>
        <div class="card">
            <h2><%= stats.totalUsers %></h2>
            <p>Benutzer gesamt</p>
        </div>
        <% } %>
    </div>

    <div class="nav">
        <a href="/devices">Geräte verwalten</a>
        <a href="/devices/add">Neues Gerät</a>
        <a href="/logout" class="logout">Logout</a>
    </div>

</div>

</body>
</html>