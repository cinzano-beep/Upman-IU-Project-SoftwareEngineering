<!DOCTYPE html>
<html>
<head>
    <title><%= appName %> – Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            margin: 0;
            padding: 40px;
        }

        h1 {
            margin-bottom: 5px;
        }

        .subtitle {
            color: #777;
            margin-bottom: 30px;
        }

        .cards {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            flex: 1;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .card h2 {
            margin: 0;
            font-size: 32px;
        }

        .card p {
            margin: 5px 0 0 0;
            color: #666;
        }

        .critical {
            border-left: 5px solid #e74c3c;
        }

        .warning {
            border-left: 5px solid #f39c12;
        }

        .success {
            border-left: 5px solid #2ecc71;
        }

        .buttons {
            margin-bottom: 40px;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            color: white;
            margin-right: 10px;
        }

        .btn-primary {
            background: #3498db;
        }

        .btn-dark {
            background: #555;
        }

        .alerts {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .alert-item {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .alert-item:last-child {
            border-bottom: none;
        }

        .cve {
            color: #e74c3c;
            font-weight: bold;
        }

        .device-title {
            margin-top: 30px;
            margin-bottom: 10px;
        }

    </style>
</head>
<body>

<h1>Dashboard</h1>
<div class="subtitle">Willkommen – Rolle: <%= user.role %></div>

<div class="cards">
    <div class="card">
        <h2><%= totalDevices %></h2>
        <p>Geräte gesamt</p>
    </div>

    <div class="card critical">
        <h2><%= criticalCount %></h2>
        <p>Kritische Updates</p>
    </div>

    <div class="card warning">
        <h2><%= availableCount %></h2>
        <p>Updates verfügbar</p>
    </div>

    <div class="card success">
        <h2><%= upToDateCount %></h2>
        <p>Aktuell</p>
    </div>
</div>

<div class="buttons">
    <a class="btn btn-primary" href="/devices">Geräte verwalten</a>
    <a class="btn btn-dark" href="/logout">Logout</a>
</div>

<% if (securityAlerts.length > 0) { %>
    <div class="alerts">
        <h2>Gerätebezogene Sicherheitswarnungen (NVD / NIST)</h2>

        <% securityAlerts.forEach(device => { %>

            <div class="device-title">
                <strong>Gerät:</strong> <%= device.deviceName %>
                (<%= device.keyword %>)
            </div>

            <% device.alerts.forEach(alert => { %>
                <div class="alert-item">
                    <div class="cve"><%= alert.cveId %></div>
                    <div><%= alert.description %></div>
                    <small>Veröffentlicht: <%= alert.published %></small>
                </div>
            <% }) %>

        <% }) %>

    </div>
<% } %>

</body>
</html>